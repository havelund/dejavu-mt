// A resource may be used only while granted and not revoked since.
// The trace grants one long-lived resource and then churns many short-lived
// ones (grant/revoke pairs), which makes dead value-terms accumulate in the
// `since` formula -- a workload where periodic GC bounds the representation.
pred grant(r: String)
pred revoke(r: String)
pred use(r: String)

prop access : Forall r . use(r) -> (!revoke(r)) S grant(r)
